# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Dataset cache (staged on cloud per CLOUD_TRAINING.md)
data/metadit/*
!data/metadit/.gitkeep

# Checkpoint artifacts — keep only REPORT.md/BUGLOG.md records
checkpoints/*
!checkpoints/.gitkeep
!checkpoints/*/
!checkpoints/*/REPORT.md
!checkpoints/*/BUGLOG.md
checkpoints/**/*.pt
checkpoints/**/*.pth
checkpoints/**/*.ckpt
checkpoints/**/*.json
checkpoints/**/*.jsonl
!checkpoints/**/REPORT.md
!checkpoints/**/BUGLOG.md
checkpoints/**/adaptive/

# Logs
logs/*
!logs/.gitkeep

# Root-level probe/debug scratch files (out_*.py/.json/.txt)
/out_*

# Model weights anywhere
*.safetensors
*.ckpt
*.pt
*.pth

# Misc
*.log
.env
.env.*
.DS_Store
Thumbs.db
.idea/
.vscode/
.ipynb_checkpoints/